# ---------------------------------------------------------------------------
# Firebase Admin — server side only, used ONLY when saving/loading flows.
# Firestore Database > create in test mode, then Project settings >
# Service accounts > Generate new private key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and the literal \n escapes from the JSON key file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
