{
  "name": "testflow",
  "version": "0.1.0",
  "private": true,
  "//engines": "firebase-admin@14 requires Node >=22. With nothing declared here a host is free to build on an older runtime, where firebase-admin throws while its MODULE IS EVALUATED — before any handler runs, so the route cannot turn it into a JSON error and the platform serves a plain-text 500 instead. Deploy targets read this field to pick the runtime; it is what keeps prod on the version the dependencies actually require.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p extension",
    "build:ext": "node extension/build.mjs",
    "e2e": "npm run build:ext && tsx scripts/e2e-record.mts",
    "e2e:replay": "npm run build:ext && tsx scripts/e2e-replay.mts",
    "e2e:runner": "tsx scripts/e2e-runner.mts",
    "e2e:cli": "npm run build:ext && tsx scripts/e2e-cli.mts",
    "flow": "tsx scripts/run-flow.mts",
    "e2e:long": "npm run build:ext && tsx scripts/e2e-longflow.mts"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "uuid": "^11.1.1",
    "node-domexception": "file:./vendor/node-domexception"
  }
}
